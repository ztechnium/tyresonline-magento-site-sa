<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="../../../../../../../lib/internal/Magento/Framework/View/Layout/etc/page_configuration.xsd">
    <body>
        <referenceContainer name="content">
            <block class="Hdweb\Booking\Block\Adminhtml\Items" name="adminhtml.block.promo.quote.grid.container">
                <block class="Magento\Backend\Block\Widget\Grid" name="adminhtml.block.promo.quote.grid" as="grid">
                    <arguments>
                        <argument name="id" xsi:type="string">hdweb_booking_items_grid</argument>
                        <argument name="dataSource" xsi:type="object">Hdweb\Booking\Model\Resource\Items\Collection</argument>
                        <argument name="default_sort" xsi:type="string">appointment_id</argument>
                        <argument name="default_dir" xsi:type="string">DESC</argument>
                        <argument name="save_parameters_in_session" xsi:type="string">1</argument>
                    </arguments>
                    <block class="Magento\Backend\Block\Widget\Grid\ColumnSet" as="grid.columnSet" name="adminhtml.promo.quote.grid.columnSet">
                        <arguments>
                            <argument name="rowUrl" xsi:type="array">
                                <!-- <item name="path" xsi:type="string"></item> -->
                                <item name="path" xsi:type="string">*/*/edit</item>
                                <item name="extraParamsTemplate" xsi:type="array">
                                    <item name="id" xsi:type="string">getId</item>
                                </item>
                            </argument>
                        </arguments>
                        <block class="Magento\Backend\Block\Widget\Grid\Column" as="id">
                            <arguments>
                                <argument name="header" xsi:type="string" translate="true">ID</argument>
                                <argument name="index" xsi:type="string">appointment_id</argument>
                                <argument name="column_css_class" xsi:type="string">col-id</argument>
                                <argument name="header_css_class" xsi:type="string">col-id</argument>
                            </arguments>
                        </block>
                        <block class="Magento\Backend\Block\Widget\Grid\Column" as="fname">
                            <arguments>
                                <argument name="header" xsi:type="string" translate="true">First Name</argument>
                                <argument name="index" xsi:type="string">fname</argument>
                            </arguments>
                        </block>
                        <block class="Magento\Backend\Block\Widget\Grid\Column" as="lname">
                            <arguments>
                                <argument name="header" xsi:type="string" translate="true">Last Name</argument>
                                <argument name="index" xsi:type="string">lname</argument>
                            </arguments>
                        </block>
                        <block class="Magento\Backend\Block\Widget\Grid\Column" as="phonenumber">
                            <arguments>
                                <argument name="header" xsi:type="string" translate="true">Phone Number</argument>
                                <argument name="index" xsi:type="string">phonenumber</argument>
                            </arguments>
                        </block>
                        <block class="Magento\Backend\Block\Widget\Grid\Column" as="email">
                            <arguments>
                                <argument name="header" xsi:type="string" translate="true">Email</argument>
                                <argument name="index" xsi:type="string">email</argument>
                            </arguments>
                        </block>
                        <!-- <block class="Magento\Backend\Block\Widget\Grid\Column" as="date">
                            <arguments>
                                <argument name="header" xsi:type="string" translate="true">Date</argument>
                                <argument name="index" xsi:type="string">date</argument>
                            </arguments>
                        </block>
                        <block class="Magento\Backend\Block\Widget\Grid\Column" as="appointment_time">
                            <arguments>
                                <argument name="header" xsi:type="string" translate="true">Time</argument>
                                <argument name="index" xsi:type="string">appointment_time</argument>
                            </arguments>
                        </block> -->
                        <block class="Magento\Backend\Block\Widget\Grid\Column" as="make">
                            <arguments>
                                <argument name="header" xsi:type="string" translate="true">Make</argument>
                                <argument name="index" xsi:type="string">make</argument>
                            </arguments>
                        </block>
						<block class="Magento\Backend\Block\Widget\Grid\Column" as="model">
                            <arguments>
                                <argument name="header" xsi:type="string" translate="true">Model</argument>
                                <argument name="index" xsi:type="string">model</argument>
                            </arguments>
                        </block>
						<block class="Magento\Backend\Block\Widget\Grid\Column" as="year">
                            <arguments>
                                <argument name="header" xsi:type="string" translate="true">Year / Engine</argument>
                                <argument name="index" xsi:type="string">year</argument>
                            </arguments>
                        </block>
						<block class="Magento\Backend\Block\Widget\Grid\Column" as="vin">
                            <arguments>
                                <argument name="header" xsi:type="string" translate="true">VIN</argument>
                                <argument name="index" xsi:type="string">vin</argument>
                            </arguments>
                        </block>
                        <block class="Magento\Backend\Block\Widget\Grid\Column" as="service">
                            <arguments>
                                <argument name="header" xsi:type="string" translate="true">Service</argument>
                                <argument name="index" xsi:type="string">service</argument>
                            </arguments>
                        </block>
                        <block class="Magento\Backend\Block\Widget\Grid\Column" as="message">
                            <arguments>
                                <argument name="header" xsi:type="string" translate="true">Message</argument>
                                <argument name="index" xsi:type="string">message</argument>
                            </arguments>
                        </block>
                        <block class="Magento\Backend\Block\Widget\Grid\Column" as="status">
                            <arguments>
                                <argument name="header" xsi:type="string" translate="true">Status</argument>
                                <argument name="index" xsi:type="string">status</argument>
                            </arguments>
                        </block>
                        <block class="Magento\Backend\Block\Widget\Grid\Column" as="created_at">
                            <arguments>
                                <argument name="header" xsi:type="string" translate="true">Created At</argument>
                                <argument name="index" xsi:type="string">created_at</argument>
                            </arguments>
                        </block>
                        <block class="Magento\Backend\Block\Widget\Grid\Column" as="updated_at">
                            <arguments>
                                <argument name="header" xsi:type="string" translate="true">Updated At</argument>
                                <argument name="index" xsi:type="string">updated_at</argument>
                            </arguments>
                        </block>
                    </block>
                </block>
            </block>
        </referenceContainer>
    </body>
</page>
