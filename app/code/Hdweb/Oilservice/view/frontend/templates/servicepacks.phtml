$class ='no-service-packs';
$hasData ='';

$hasServicePacks   			  = $servicePacksCollection['hasServicePacks'];

$oilchangeProductCollection   = $servicePacksCollection['oilchangecollection'];
$oilfilterProductCollection   = $servicePacksCollection['oilfiltercollection'];
$airfilterProductCollection   = $servicePacksCollection['airfiltercollection'];
$acfilterProductCollection   = $servicePacksCollection['acfiltercollection'];
