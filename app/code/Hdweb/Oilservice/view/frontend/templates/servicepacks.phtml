$oilFilteroptions = array();
$airFilteroptions = array();
$acFilteroptions = array();

$superbservice_product_price ='';
$superbserviceTotal ='';
$superbTotal ='';

$premiumservice_product_price ='';
$premiumserviceTotal ='';
$premiumTotal ='';

$standardservice_product_price ='';
$standardserviceTotal ='';
$standardTotal ='';


if($hasServicePacks && $setVehicle){
	$hasData = 1; // has vehicle and has servicepack
}else if(!$hasServicePacks && !$setVehicle){
	$hasData = 0; // no vehicle and no servicepack
}else{
	$hasData = 2; // has vehicle and no servicepack
}

//if(count($oilchangeProductCollection->getData()) > 0 && count($oilfilterProductCollection->getData()) > 0 && count($airfilterProductCollection->getData()) > 0 && count($acfilterProductCollection->getData()) > 0){
if($hasData == 1){
	$class ='';
	
	/* Start Oil change product collection */
	if(count($oilchangeProductCollection->getData()) > 0){
		foreach($oilchangeProductCollection as $product){
			
			if(!$product->getHasOptions()){
				continue;
			}
			$customOptions = $objectManager->get('Magento\Catalog\Model\Product\Option')->getProductOptionCollection($product);
			
			 foreach ($customOptions as $o) {
				foreach ($o->getValues() as $value) {
					if($value->getTitle() != $vehicle_oil_litre){
						continue;
					}else{
						$sumprice = $value['price'] + $product->getPrice();
						$multiplyPrice = $sumprice * 0.05;
						$customOptionPrice = $sumprice + $multiplyPrice;
						$customOptionPrice = number_format($customOptionPrice, 2);
						//$options['price'] = $currency.' '.$customOptionPrice;
						$oilOptions['price_amount'] = $customOptionPrice;
						$oilOptions['product_id'] = $product->getId();
						$oilOptions['sku'] = $product->getSku();
						$oilOptions['oil_litre'] = $vehicle_oil_litre;
						$oilOptions['brand_id'] = $product->getMgsBrand();
					}
				}
			 }
		}
	}
	/* End Oil change product collection */
	
	/* Start Oil filter product collection */ 
	if(count($oilfilterProductCollection->getData()) > 0){
		foreach($oilfilterProductCollection as $product){
			$finalPricewithtax = $listingHelper->getSet1price($product);
			//$price = $currency.' '.number_format($finalPricewithtax, 2);
			//$options['price'] = $price;
			$oilFilteroptions['price_amount'] = $finalPricewithtax;
			$oilFilteroptions['product_id'] = $product->getId();
			$oilFilteroptions['sku'] = $product->getSku();
			$oilFilteroptions['brand_id'] = $product->getMgsBrand();
		}
	}
	/* End Oil filter product collection */
	
	/* Start Air filter product collection */ 
	if(count($airfilterProductCollection->getData()) > 0){
		foreach($airfilterProductCollection as $product){
			$finalPricewithtax = $listingHelper->getSet1price($product);
			//$price = $currency.' '.number_format($finalPricewithtax, 2);
			//$options['price'] = $price;
			$airFilteroptions['price_amount'] = $finalPricewithtax;
			$airFilteroptions['product_id'] = $product->getId();
			$airFilteroptions['sku'] = $product->getSku();
			$airFilteroptions['brand_id'] = $product->getMgsBrand();
		}
	}
	/* End Air filter product collection */
	
	/* Start AC filter product collection */ 
	if(count($acfilterProductCollection->getData()) > 0){
		foreach($acfilterProductCollection as $product){
			$finalPricewithtax= $listingHelper->getSet1price($product);
			//$price = $currency.' '.number_format($finalPricewithtax, 2);
			//$options['price'] = $price;
			$acFilteroptions['price_amount'] = $finalPricewithtax;
			$acFilteroptions['product_id'] = $product->getId();
			$acFilteroptions['sku'] = $product->getSku();
			$acFilteroptions['brand_id'] = $product->getMgsBrand();
		}
	}
	/* End AC filter product collection */
		
	$superbTotal = $oilOptions['price_amount'] + $oilFilteroptions['price_amount'] + $airFilteroptions['price_amount'] + $acFilteroptions['price_amount'];
	$superbTotal = number_format($superbTotal, 2);
	$superbservice_product_price = $superbservice_product_base_price + $superbTotal;
	//$superbserviceTotal = number_format($superbservice_product_price, 2);
	$superbserviceTotal = $superbservice_product_price;
	$superbserviceDiscounted = ($superbserviceTotal * $superbDiscount / 100);
	$superbserviceTotal = number_format($superbserviceTotal - $superbserviceDiscounted, 2);
	
	$premiumTotal = $oilOptions['price_amount'] + $oilFilteroptions['price_amount'] + $airFilteroptions['price_amount'];
	$premiumTotal = number_format($premiumTotal, 2);
	$premiumservice_product_price = $premiumservice_product_base_price + $premiumTotal;
	//$premiumserviceTotal = number_format($premiumservice_product_price, 2);
	$premiumserviceTotal = $premiumservice_product_price;
	$premiumserviceDiscounted = ($premiumserviceTotal * $premiumDiscount / 100);
	$premiumserviceTotal = number_format($premiumserviceTotal - $premiumserviceDiscounted, 2);
	
	$standardTotal = $oilOptions['price_amount'] + $oilFilteroptions['price_amount'];
	$standardTotal = number_format($standardTotal, 2);
	$standardservice_product_price = $standardservice_product_base_price + $standardTotal;
	//$standardserviceTotal = number_format($standardservice_product_price, 2);
	$standardserviceTotal = $standardservice_product_price;
	$standardserviceDiscounted = ($standardserviceTotal * $standardDiscount / 100);
	$standardserviceTotal = number_format($standardserviceTotal - $standardserviceDiscounted, 2);
}

