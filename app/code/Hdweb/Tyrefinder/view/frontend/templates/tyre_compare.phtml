                                        <path d="M41.5024 5.89697C50.5961 3.13991 60.3242 3.23239 69.3755 6.17334L70.2065 6.45166C78.7618 9.41068 86.2647 14.8008 91.7983 21.9556C92.5084 22.8736 92.2887 24.175 91.3716 24.8413L82.4722 31.3071C81.5448 31.9807 80.2748 31.7592 79.5854 30.8911C75.8736 26.2173 70.9018 22.6938 65.2505 20.7417L64.7017 20.5581C58.5929 18.5733 52.0274 18.5107 45.8901 20.3716L45.2983 20.5571C39.1897 22.542 33.8416 26.3516 29.9702 31.4644L29.6001 31.9624C26.0805 36.8067 24.0273 42.5454 23.6626 48.4956L23.6333 49.0718C23.5857 50.1793 22.6878 51.104 21.5415 51.104H10.5415C9.40791 51.104 8.46471 50.1811 8.49951 49.021L8.53467 48.147C8.9753 39.1246 12.035 30.4072 17.3638 23.0728L17.9116 22.3335C23.648 14.7576 31.573 9.11435 40.6245 6.17334L41.5024 5.89697Z" fill="#F56200" stroke="black" stroke-width="1.375"/>
                                        <path d="M48.3599 4.37256C54.947 3.42262 61.6586 3.89709 68.0415 5.76123C69.0861 6.06633 69.6671 7.12468 69.4468 8.14404L69.3921 8.34717L65.9927 18.8081C65.6385 19.8983 64.4817 20.4665 63.4136 20.1694C59.3537 19.0401 55.106 18.7391 50.9243 19.2866L50.0884 19.4077C45.5008 20.1343 41.1356 21.8694 37.3052 24.4829L36.5454 25.0171C32.7878 27.7472 29.6859 31.2747 27.4595 35.3423L27.0259 36.1636C24.9805 40.178 23.8259 44.5809 23.6333 49.0718C23.5858 50.1794 22.6878 51.104 21.5415 51.104H10.5415C9.40802 51.104 8.4647 50.1812 8.49951 49.021C8.70545 42.1599 10.4278 35.4227 13.5493 29.2964L13.8667 28.686C17.186 22.4031 21.9021 16.9611 27.6558 12.7808L28.2153 12.3804C34.0252 8.28914 40.6978 5.58083 47.7222 4.46826L48.3599 4.37256Z" fill="#FECA2A" stroke="black" stroke-width="1.375"/>
                                        <path d="M39.3032 6.62354C40.3957 6.23201 41.5652 6.84428 41.9155 7.92236L45.3149 18.3833L45.3696 18.5884C45.5915 19.6132 45.0015 20.6372 44.0278 21.0005C38.4356 23.0863 33.5478 26.726 29.9448 31.4976L29.6001 31.9624C25.9671 36.9628 23.8972 42.9164 23.6333 49.0718C23.5857 50.1793 22.6878 51.104 21.5415 51.104H10.5415C9.40791 51.104 8.46471 50.1811 8.49951 49.021C8.77953 39.6884 11.8631 30.6438 17.3638 23.0728L17.8853 22.3677C23.3432 15.1455 30.7885 9.67534 39.3032 6.62354Z" fill="#94C530" stroke="black" stroke-width="1.375"/>
                                        <path d="M16.6899 24.043C17.3753 23.234 18.5762 23.104 19.436 23.7285L28.3354 30.1943C29.2629 30.8681 29.4451 32.1444 28.8325 33.0684C25.6756 37.8299 23.8781 43.3636 23.6333 49.0713C23.5858 50.1789 22.6878 51.1045 21.5415 51.1045H10.5415C9.40803 51.1045 8.46492 50.1814 8.49951 49.0215C8.76557 40.1534 11.5628 31.5447 16.5601 24.2139L16.6899 24.043Z" fill="#01CE34" stroke="black" stroke-width="1.375"/>
                                        <g transform="rotate(${ (product.tire_score * 240 / 10) || 0 }, 54.9998, 45.8331)">
                                            <path d="M59.0285 46.0819C58.5285 47.8258 56.7095 48.8342 54.9656 48.3342C53.2218 47.8342 52.2135 46.0151 52.7135 44.2713C53.2135 42.5274 55.0325 41.5191 56.7763 42.0191C58.5202 42.5191 59.5285 44.3381 59.0285 46.0819Z" fill="black"/>
                                            <path fill-rule="evenodd" clip-rule="evenodd" d="M51.1008 50.7444L45.7775 50.6899L48.5671 45.8723C48.484 45.0095 48.5536 44.1173 48.7964 43.2315C49.8672 39.3255 53.9015 37.0271 57.8075 38.0979C61.7135 39.1686 64.0119 43.203 62.9412 47.109C61.8704 51.015 57.836 53.3135 53.93 52.2427C52.8522 51.9473 51.8969 51.4262 51.1008 50.7444ZM61.3941 46.6849C60.5576 49.7366 57.4056 51.5321 54.3541 50.6956C51.3026 49.8591 49.5069 46.7072 50.3434 43.6556C51.1799 40.6041 54.3319 38.8085 57.3834 39.645C60.4349 40.4815 62.2307 43.6334 61.3941 46.6849Z" fill="black"/>
                                        </g>
                                    </svg>
                                    <div class="tire-score-label">
                                        <span class="sub-label"><?= $ksaScoreLabel ?></span>
                                        <span>${product.tire_score || 0}</span>
                                    </div>
                                </div>
                            `)

                            renderFeatureBar('.tire-feature.dry-handling', product.dry_handling);
                            renderFeatureBar('.tire-feature.wet-handling', product.wet_handling);
                            renderFeatureBar('.tire-feature.snow', product.snow);
                            renderFeatureBar('.tire-feature.comfort', product.comfort);

                            $('.tire-spec.speed-rating').append(`
                                <div class="tire-spec-container">
                                    <span>${product.speed_rating}</span>
                                </div>
                            `)

                            $('.tire-spec.load-index').append(`
                                <div class="tire-spec-container">
                                    <span>${product.load_index}</span>
                                </div>
                            `)

                            $('.tire-spec.oem').append(`
                                <div class="tire-spec-container">
                                    <span>${product.oem_tyre || '-'}</span>
                                </div>
                            `)

                            $('.tire-spec.year').append(`
                                <div class="tire-spec-container">
                                    <span>${product.year}</span>
                                </div>
                            `)

                            $('.tire-spec.warranty').append(`
                                <div class="tire-spec-container">
                                    <span>${product.warranty}</span>
                                </div>
                            `)

                            $('.tire-spec.sku').append(`
                                <div class="tire-spec-container">
                                    <span>${product.sku}</span>
                                </div>
                            `)

                            $('.tire-spec.runflat').append(`
                                <div class="tire-spec-container">
                                    <span>${product.runflat ? 'Yes' : 'No'}</span>
                                </div>
                            `)

                            $('.tire-spec.vehicle-type').append(`
                                <div class="tire-spec-container">
                                    <img src="<?php echo $mediaUrl . 'images/icon/car-fitment.svg' ?>" alt="Car Fitment">
                                </div>
                            `)
                        });

                        if(products.length < 3) {
                            $('.tire-images, .tire-products, .tire-price, .tire-score, .tire-feature, .tire-spec').addClass('double-tire');
                            $('.tire-images').append(`
                            <div class="tire-img">
                                <img src="<?php echo $mediaUrl . 'images/products/tire.png' ?>" alt="tire">
                            </div>`);
                            $('.tire-products').append(`
                            <div class="tire-product" data-productid="">
                                <button class="add-tyre"><?= $block->escapeHtml(__('Add Tyre')) ?></button>
                            </div>`);
                        } else {
                            $('.tire-images, .tire-products, .tire-price, .tire-score, .tire-feature, .tire-spec').removeClass('double-tire');
                        }
                    }
                },
                error: function(xhr, status, error) {
                    console.error('Request failed with status: ' + status + ', ' + error);
                }
            });
        });

        $(document).on('click', '.add-to-cart', function () {
            const $product = $(this).closest('.tire-product');
            const productId = $product.data('productid');
            
            const $form = $('form[data-role="tocart-form"]').filter(function () {
                return $(this).find('input[name="product"]').val() == productId;
            }).first();
            $form.find('button[type="submit"]').trigger('click');
        });
    });
  });
</script>
<style>
    * {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
    }

    .no-scroll {
        overflow: hidden;
    }

    .double-tire {
        grid-template-columns: 3fr 3fr 2fr !important;
    }

    .product-compare-toggle.disabled {
        opacity: 0.5;
        cursor: not-allowed;
    }
    
    .tyre-compare.tyre-overlay::before {
        content: "";
        position: fixed;
        z-index: 98;
        top: 0;
        left: 0;
        width: 100vw;
        height: 100vh;
        background-color: rgba(0, 0, 0, 0.6);
    }
    
    .tyre-compare-panel {
        max-width: 800px;
        width: 0;
        margin: 0;
        background-color: white;
        position: fixed;
        height: 100%;
        z-index: 99;
        right: 0;
        top: 0;
        transition: width 0.3s ease;
        overflow: auto;
    }

    .tyre-compare-wrapper {
        margin: 10px 0px;
        display: flex;
        justify-content: space-between;
        padding: 0 5vw;
    }

    .tyre-compare-total {
        display: flex;
        justify-content: center;
        align-items: center;
        color: #fff;
        font-size: 24px;
        font-weight: 900;
        font-style: italic;
    }

    .tyre-compare-panel.active {
        width: 40%;
    }
    
    .tire-images {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 20px;
        padding: 20px;
        background-color: white;
    }
    
    .tire-img {
        display: flex;
        justify-content: center;
        align-items: center;
        
        img {
            max-width: 50%;
            max-height: 80%;
        }
    }
    
    .tire-products {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 20px;
        background-color: #d70000;
        color: white;
        padding: 10px 20px;
    }
    
    .tire-product {
        flex: 1;
    }
    
    .product-name {
        font-weight: bold;
        font-size: 14px;
        margin-bottom: 5px;
    }
    
    .product-specs {
        font-size: 12px;
        margin-bottom: 10px;
    }
    
    .add-to-cart {
        background: #fff;
        color: #d70000;
        border: none;
        border-radius: 15px;
        padding: 5px 15px;
        font-size: 12px;
        font-weight: bold;
    }

    .contact-us {
        background: #fff;
        color: #d70000 !important;
        border: none;
        border-radius: 15px;
        padding: 5px 15px;
        font-size: 12px;
        font-weight: bold;
    }

    .add-tyre {
        display: block;
        background: transparent;
        color: #fff;
        border: 1px solid #fff;
        border-radius: 15px;
        padding: 5px 15px;
        margin: auto;
        font-size: 12px;
        font-weight: bold;
        white-space: nowrap;
    }
    
    .compare-section {
        padding: 20px 0px;
        margin:0px 20px;
    }

    .tire-price-section {
        border-bottom:  #00000066 1px solid;
    }

    .tire-score-section {
        border-bottom:  #00000066 1px solid;
    }

    .tire-feature-section {
        border-bottom:  #00000066 1px solid;
    }

    .tire-score-section .tire-score {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 20px;
    }

    .tire-score-section .double-tire {
        display: grid;
