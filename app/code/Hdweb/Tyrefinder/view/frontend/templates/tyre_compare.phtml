<script type="text/javascript">
  require(["jquery"], function($) {

    $(document).on('mouseup', function(e) {
        const $panel = $(".tyre-compare-panel");
        const $overlay = $(".tyre-compare");

        if (!$panel.is(e.target) && $panel.has(e.target).length === 0 && $panel.hasClass('active')) {
            $overlay.removeClass('tyre-overlay');
            $panel.removeClass('active');
            $('body').removeClass('no-scroll');
        }
    });

    $(document).ready(function() {
        $('.product-compare-toggle').on('click', function (e) {
            const $btn = $(this);
            const $wrap = $btn.closest('.product-box');
            const productId = $wrap.data('productid');
            const $input = $('input[name="product_ids"]');
            const $compareBar = $('.tyre-compare-bar');

            let currentVal = $input.val();
            let ids = [];

            try {
                ids = JSON.parse(currentVal);
            } catch (e) {
                ids = [];
            }

            const allWraps = $(`.product-box[data-productid="${productId}"]`);
            const allBtns = allWraps.find('.product-compare-toggle');

            if ($wrap.hasClass('selected-compare')) {
                allWraps.removeClass('selected-compare');
                allBtns.text('<?= $compareLabel ?>').removeClass('active');
                ids = ids.filter(id => id != productId);
            } else {
                if (ids.length >= 3) {
                    return;
                }
                allWraps.addClass('selected-compare');
                allBtns.text('<?= $selectedLabel ?>').addClass('active');
                if (!ids.includes(productId)) {
                    ids.push(productId);
                }
            }

            $input.val(JSON.stringify(ids));

            if (ids.length >= 2) {
                $compareBar.addClass('active');
            } else {
                $compareBar.removeClass('active');
            }

            if (ids.length >= 3) {
                $('.product-compare-toggle').each(function () {
                    const $this = $(this);
                    const pid = $this.closest('.product-box').data('productid');
                    if (!ids.includes(pid)) {
                        $this.prop('disabled', true).addClass('disabled');
                    }
                });
            } else {
                $('.product-compare-toggle').prop('disabled', false).removeClass('disabled');
            }

            $('.tyre-compare-total').text(`${ids.length} <?= $itemsSelectedLabel ?>`);
        });

        $('.clear-all').on('click', function (e) {
            const $input = $('input[name="product_ids"]');
            let currentVal = $input.val();
            let ids = [];

            try {
                ids = JSON.parse(currentVal);
            } catch (e) {
                ids = [];
            }

            ids.forEach((id) => {
                const $productBox = $(`.product-box[data-productid="${id}"]`);
                $productBox.removeClass('selected-compare');
                $productBox.find('.product-compare-toggle').text('<?= $compareLabel ?>').removeClass('active');
            });
            $('.tyre-compare-bar').removeClass('active');
            $input.val([]);
        });

        $(document).on('click', '.add-tyre', function (e) {
            $('body').removeClass('no-scroll');
            $('.tyre-compare-panel').removeClass('active');
            $('.tyre-compare').removeClass('tyre-overlay');
        });

        function renderFeatureBar(selector, score) {
            const percentage = (score / 5) * 100;
            $(selector).append(`
                <div class="tire-feature-rating">
                    <div class="bar-container">
                        <span class="score">${score}</span>
                        <div class="bar"><span class="bar-fill" style="width: ${percentage}%;"></span></div>
                    </div>
                </div>
            `);
        }

        $('#tyre-compare-form').submit(function(event) {
            event.preventDefault();

            var formData = $(this).serialize();
            $.ajax({
                url: $(this).attr('action'),
                type: 'POST',
                data: formData,
                dataType: 'json',
                success: function(response) {
                    if (response.status === 'SUCCESS') {
                        $('.tyre-compare').toggleClass('tyre-overlay');
                        $('.tyre-compare-panel').toggleClass('active');
                        $('body').addClass('no-scroll');
                        var products = response.products;
                        $('.tire-images, .tire-products, .tire-price, .tire-score, .tire-feature, .tire-spec').empty();
                        
                        $.each(products, function(index, product) {
                            $('.tire-images').append(`
                            <div class="tire-img">
                                <img src="${product.image}" alt="${product.name}">
                            </div>`);

                            $('.tire-products').append(`
                                <div class="tire-product" data-productid="${product.id}">
                                    <div class="product-name">${product.display_name}</div>
                                    <div class="product-specs">${product.tyre_size}</div>
                                    ${product.is_enabled
                                        ? `<button class="add-to-cart"><?= __('Add To Cart'); ?></button>`
                                        : `<a href="https://api.whatsapp.com/send?phone=97180025589737&text=Hello%20Tyres%20Online" target="_blank" class="contact-us"><span><?= __("Contact us"); ?></span></a>`
                                    }
                                </div>
                            `);

                            $('.tire-price').append(`
                            <div class="price">
                                <span><?= $currencyCode ?> ${product.price}/type</span>
                            </div>`);

                            $('.tire-score').append(`
                                <div style="width: fit-content;">
