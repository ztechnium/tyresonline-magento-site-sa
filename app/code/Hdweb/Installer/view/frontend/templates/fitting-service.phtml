<?php
$objectManager =  \Magento\Framework\App\ObjectManager::getInstance();
$Quote = $objectManager->get('Magento\Checkout\Model\Cart');
$isEnablefitmentinstaller = $objectManager->get('Magento\Framework\App\Config\ScopeConfigInterface')->getValue('installer/general/no_fitment_installer');
$InstallerId = 0; //$Quote->getQuote()->getInstallerId();
$hasMobileVanTyreServiceProduct = $objectManager->create('Hdweb\Installer\Helper\Data')->checkMobileVanTyreServiceProduct();
$hasMobileVanTyreService = 0;
if(isset($_COOKIE['mobilevanservice_data']) || $hasMobileVanTyreServiceProduct){
	$hasMobileVanTyreService = 1;
}
$isStarlightProducts = $objectManager->create('Hdweb\Installer\Helper\Data')->isStarlightProducts();
$hideFitmentStatusBar = $block->getRequest()->getFullActionName() === 'checkout_index_index';
?>
<?php if($isEnablefitmentinstaller != ''):?>
<div class="garage">
	<?php if(!$hasMobileVanTyreService && !$isStarlightProducts):?>
	<div class="garage_switch">
		<div class="container_switch">
		  <div class="switch-title"><span><?php echo __('With Fitment?');?></span></div>
		  <div class="switch fitment-toggle">
			<input type="radio" class="fitment-toggle-input" name="fitment_installer" value="1" id="fully-fitted" checked>
			<label for="fully-fitted" class="fitment-toggle-label"><?php echo __('Yes');?></label>
			<input type="radio" class="fitment-toggle-input" name="fitment_installer" value="0" id="mail-order">
			<label for="mail-order" class="fitment-toggle-label"><?php echo __('No');?></label>
		  </div>
		</div>
	</div>

	<?php if (!$hideFitmentStatusBar): ?>
	<div class="garage-info" id="ship_to_installer">
		<div class="not_selected">
			<p><?php echo __('With Fitment - Deliver to Fitting Location');?></p>
		</div>
	</div>

	<div class="garage-info" id="ship_to_address" style="display:none">
		<div class="not_selected">
			<p><?php echo __('Without Fitment - Deliver to Shipping Address');?></p>
		</div>
	</div>
	<?php endif; ?>
	<input type="hidden" id="fitment_installerId" value="<?php echo $isEnablefitmentinstaller;?>" />
	<?php else:?>
		<?php if(!isset($_COOKIE['mobilevanservice_data'])):?>
			<div class="garage-info ifmobilevan-service">
				<span class="container_switch">
					<a class="add-location" data-izimodal-open="#mobilevanservice"><span><?php echo __('Add Location');?></span></a>
				</span>
			</div>
		<?php else:?>
			<?php
			$cookieValue = stripslashes($_COOKIE['mobilevanservice_data']);
			$serviceData = json_decode($cookieValue, true);
			$mobilevanserviceLocation_lat = $serviceData['mobilevanservice_location_lat'];
			$mobilevanserviceLocation_lng = $serviceData['mobilevanservice_location_lng'];
			$mobilevanserviceDate = $serviceData['mobilevanservice_date'];
			$mobilevanserviceTime = $serviceData['mobilevanservice_time'];
			$installer_datetime = date("l, F d, Y", strtotime($mobilevanserviceDate)).' - '.$mobilevanserviceTime;
			$latLong = $mobilevanserviceLocation_lat.','.$mobilevanserviceLocation_lng;
			?>
			<div class="garage-info ifmobilevan-service">
				<span class="container_switch"><?php echo $installer_datetime.', ';?> <a href="http://maps.google.com/?q=<?php echo $latLong;?>" target="_blank"><?php echo __('Location Coordinates');?></a></span>
			</div>
		<?php endif;?>
	<?php endif;?>
</div>
<?php endif;?>

<?php /* End Fitment Installer Toggle */ ?>
<script type="text/javascript">
require([
	'jquery',
	'mage/storage',
	'Magento_Checkout/js/model/quote',
	'Magento_Checkout/js/action/get-totals',
	'Magento_Checkout/js/model/cart/totals-processor/default'
	], function($,storage,quote,getTotalsAction,totalsDefaultProvider){
	jQuery('.container_switch input[type=radio]').change(function() {
		if(this.value == "0"){
			jQuery("#ship_to_address").show();
			jQuery("#ship_to_installer").hide();
			jQuery('#cart-fitting-location').hide();
			jQuery('#custom-vehicle-div').hide();
		}else{
			jQuery("#ship_to_address").hide();
			jQuery("#ship_to_installer").show();
			jQuery('#cart-fitting-location').show();
			jQuery('#custom-vehicle-div').show();
		}

		var installerId = jQuery('#fitment_installerId').val();
		var data = {'fitment_installer': this.value,'installer_id': installerId};
		var cartInstLocText = '<?php echo __('Select'); ?>';
		return storage.post(
				'installer/ajax/setfitment',
				JSON.stringify(data),
				true
			).done(
				function (response) {
					if(response.no_fitting == 1){
						jQuery('#pickup_installer_lat').val(response.installer_lat);
						jQuery('#pickup_installer_lng').val(response.installer_lng);
						jQuery('#pickup_installer_service').val(response.pickup_service);
						jQuery('.action.checkout').show();
						jQuery('.restrict-checkout').hide();
					}else{
						jQuery('#pickup_installer_lat').val('');
						jQuery('#pickup_installer_lng').val('');
						jQuery('#pickup_installer_service').val('');
						jQuery('#cart-installer-location').text(cartInstLocText);
						jQuery('.fittingLocationList').hide();
						jQuery('.action.checkout').hide();
						jQuery('.restrict-checkout').show();
					}
					if($(".garage #ship_to_address").is(":visible")){
						$('#custom-vehicle-div .pickupDropOption .no').trigger('click');
					}
					totalsDefaultProvider.estimateTotals(quote.shippingAddress());
				}
			);
	});
	jQuery('input:radio[name="fitment_installer"]').filter('[value="1"]').attr('checked', true);
});
</script>
