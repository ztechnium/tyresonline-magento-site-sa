<?xml version="1.0"?>
<schema xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:Setup/Declaration/Schema/etc/schema.xsd">
	<table name="sales_order" resource="sales" engine="innodb" comment="Sales Order">
		<column xsi:type="text" name="erp_executive_code" nullable="true" comment="Sales ERP Executive Code"/>
	</table>
	<table name="admin_user" resource="default" engine="innodb" comment="Admin User Table">
        <column xsi:type="varchar" name="user_erp_executive_code" nullable="true" length="255" comment="ERP Executive Code"/>
    </table>
</schema>