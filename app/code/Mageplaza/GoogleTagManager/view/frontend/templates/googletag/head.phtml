use Mageplaza\GoogleTagManager\Block\Tag\ManagerTag;

/** @var ManagerTag $block */
[$dimensionsAndMetrics, $values] = $block->getDimensionsAndMetrics();
?>
<?php if ($block->canShowGtm()) : ?>
    <!-- Google Tag Manager Added by Mageplaza -->
    <!-- Global site tag (gtag.js) - Google Analytics 4 -->
    <script>(function (w, d, s, l, i) {
            w[l] = w[l] || [];
            w[l].push({
                'gtm.start':
                    new Date().getTime(), event: 'gtm.js'
            });
            var f                          = d.getElementsByTagName(s)[0],
                j = d.createElement(s), dl = l != 'dataLayer' ? '&l=' + l : '';
            j.async = true;
            j.src =
                'https://www.googletagmanager.com/gtm.js?id=' + i + dl;
            f.parentNode.insertBefore(j, f);
        })(window, document, 'script', 'dataLayer', '<?= $block->escapeHtmlAttr($block->getTagId()) ?>');</script>

    <script>

        window.dataLayer = window.dataLayer || [];

        function gtag () {
            window.dataLayer.push(arguments);
        }

        gtag('js', new Date());

        <?php if (isset($dimensionsAndMetrics['custom_map']) && $dimensionsAndMetrics['custom_map']) : ?>
            <?php foreach ($block->getGa4TagId() as $measurementId): ?>
                gtag('config', '<?= $measurementId ?>');
            <?php endforeach; ?>
        gtag('event', 'Custom Event Parameter', <?= $values ? $block->encodeJs($values) : '{}' ?>);
        <?php endif; ?>

    </script>
    <!-- End Google Tag Manager -->
<?php endif; ?>
