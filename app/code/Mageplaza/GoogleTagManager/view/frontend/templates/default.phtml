use Mageplaza\GoogleTagManager\Block\TagManager;

/** @var TagManager $block */
?>
<!--Google Tag Manager: dataLayer - Added by Mageplaza-->
<?php
if (!empty($block->getEventData())) {
    $data = $block->getEventData();
    if (!empty($data['add']['gtm'])) {
        ?>
        <script>dataLayer.push(<?= /** @noEscape */ $data['add']['gtm'] ?>);</script>
        <?php
    }
    if (!empty($data['add']['pixel'])) {
        ?>
        <script>fbq('track', 'AddToCart', <?= /** @noEscape */  $data['add']['pixel'] ?>);</script>
        <?php
    }
    if (!empty($data['wishlist']['gtm'])) {
        ?>
        <script>dataLayer.push(<?= /** @noEscape */  $data['wishlist']['gtm'] ?>);</script>
        <?php
    }
    if (!empty($data['wishlist']['pixel'])) {
        ?>
        <script>fbq('track', 'AddToWishlist', <?= /** @noEscape */  $data['wishlist']['pixel'] ?>);</script>
        <?php
    }
    $block->removeAddToWishlistData();
    if (!empty($data['add']['ga'])) {
        ?>
        <script>gtag('event', 'add_to_cart', <?= /** @noEscape */  $data['add']['ga'] ?>);</script>
        <?php
    }
    $block->removeAddToCartData();
    if (!empty($data['remove']['gtm'])) {
        ?>
        <script>dataLayer.push(<?= /** @noEscape */  $data['remove']['gtm'] ?>);</script>
        <?php
    }
    if (!empty($data['remove']['ga'])) {
        ?>
        <script>gtag('event', 'remove_from_cart', <?= /** @noEscape */  $data['remove']['ga'] ?>);</script>
        <?php
    }
    $block->removeRemoveFromCartData();

    if(!empty($data['login']['gtm'])){
        ?>
        <script>dataLayer.push(<?= /** @noEscape */  $data['login']['gtm'] ?>);</script>
        <?php
    }
    $block->removeLoginData();

    if(!empty($data['signup']['gtm'])){
        ?>
        <script>dataLayer.push(<?= /** @noEscape */  $data['signup']['gtm'] ?>);</script>
        <?php
    }

    if(!empty($data['signup']['pixel'])){
        ?>
        <script>fbq('track', 'CompleteRegistration', <?= /** @noEscape */  $data['signup']['pixel'] ?>);</script>
        <?php
    }
    $block->removeSignUpData();
}
?>
<div id="mp-event"></div>
<script type="text/javascript">
    require(["jquery"], function ($) {
        $(document).ready(function () {
            $("button.tocart").click(function () {
                var customurl = "<?php echo $this->getUrl() . 'mpgoogletagmanager/event/index'?>";
                $.ajax({
                    type: 'POST',
                    url: customurl,
                    data: {
                        customdata: 'addtocart'
                    },
                    dataType: 'json',
                    success: function (response) {
                        if (response.data) {
                            $('#mp-event').html(response.data);
                        }
                    }
                });

                if ($('#confirmBox').length > 0) {
                    var customurl = "<?php echo $this->getUrl() . 'mptagmanager/event/index'?>";
                    $.ajax({
                        type: 'POST',
                        url: customurl,
                        data: {
                            customdata: 'addtocart'
                        },
                        dataType: 'json',
                        success: function (response) {
                            if (response.data) {
                                $('#mp-event').html(response.data);
                            }
                        }
                    })
                }
            });

            $("#product-addtocart-button").mouseover(function () {
                $(this).click(function () {
                    if ($('#confirmBox').length > 0) {
                        var customurl = "<?php echo $this->getUrl() . 'mptagmanager/event/index'?>";
                        $.ajax({
                            type: 'POST',
                            url: customurl,
                            data: {
                                customdata: 'addtocart'
                            },
                            dataType: 'json',
                            success: function (response) {
                                if (response.data) {
                                    $('#mp-event').html(response.data);
                                }
                            }
                        })
                    }
                });
            });
        });
    });
</script>
