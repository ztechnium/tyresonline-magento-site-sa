<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <type name="Magento\Framework\App\FrontController">
        <plugin name="mp-gtm-cookies" type="Mageplaza\GoogleTagManager\Plugin\CookieManagement"/>
    </type>
    <type name="Magento\Checkout\Block\Cart\Crosssell">
        <plugin name="mp-gtm-cross-sell" type="Mageplaza\GoogleTagManager\Plugin\Crosssell"/>
    </type>
    <type name="Magento\Wishlist\Controller\Index\Allcart">
        <plugin name="mp-gtm-wishlist-add-all-to-cart" type="Mageplaza\GoogleTagManager\Plugin\Controller\AddAllWishlistToCart" />
    </type>
    <type name="Magento\Wishlist\Controller\Index\Cart">
        <plugin name="mp-gtm-wishlist-add-to-cart" type="Mageplaza\GoogleTagManager\Plugin\Controller\AddWishlistToCart" />
    </type>
    <type name="Magento\Checkout\Controller\Cart\Addgroup">
        <plugin name="mp-gtm-recently-order-add-to-cart" type="Mageplaza\GoogleTagManager\Plugin\Controller\AddRecentlyOrderToCart" />
    </type>
    <type name="Magento\Sales\Controller\AbstractController\Reorder">
        <plugin name="mp-gtm-reorder-add-to-cart" type="Mageplaza\GoogleTagManager\Plugin\Controller\AbstractController\AddReorderToCart" />
    </type>
    <type name="Magento\Wishlist\Controller\Index\Fromcart">
        <plugin name="mp-gtm-move-back-from-cart-to-wishlist" type="Mageplaza\GoogleTagManager\Plugin\Controller\AddBackFromCartToWishlist" />
    </type>
</config>
