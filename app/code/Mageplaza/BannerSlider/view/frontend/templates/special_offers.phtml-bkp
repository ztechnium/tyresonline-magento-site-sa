<?php
$objectManager = \Magento\Framework\App\ObjectManager::getInstance();
$offerCollection = $block->getBannerCollection();
$uniqueOfferCategories = [];
if ($offerCollection->getData()) {
    foreach ($offerCollection->getData() as $offer) {
        $offerCategory = $offer['category'];
        if (!in_array($offerCategory, $uniqueOfferCategories)) {
            $uniqueOfferCategories[] = $offerCategory;
        }
    }
}

$mediaURL = $objectManager->get('Magento\Store\Model\StoreManagerInterface')
    ->getStore()
    ->getBaseUrl(\Magento\Framework\UrlInterface::URL_TYPE_MEDIA);
$baseUrl = $this->getBaseUrl();

$categoryName = $this->getRequest()->getParam('category');
?>
<section class="section pt-5 pb-5 lg:pt-20 lg:pb-20">
    <div class="container mx-auto px-7">
        <div class="section-title text-center mb-8">
            <h2 class="uppercase font-monument text-[#18223C]">Offers <span class="text-theme-golden">& Promotions</span></h2>
            <p class="text-[#18223C] mt-2 lg:mt-3 pb-5">Discover our exclusive automotive services on our website and take advantage of our limited-time special offers.</p>
        </div>
        <?php if (!empty($uniqueOfferCategories)) : ?>
            <div x-data="{ current: '<?php echo $uniqueOfferCategories[0]; ?>' }">
                <div class="px-3 flex overflow-x-auto rounded-md shadow-[0_5px_15px_-4px_rgba(167,167,167,0.5)]">
                    <?php foreach ($uniqueOfferCategories as $uniqueOfferCategory) : ?>
                        <?php
                        $uniqueOfferCategoryUrl = strtolower($uniqueOfferCategory);
                        $uniqueOfferCategoryUrl = str_replace(' ', '-', $uniqueOfferCategoryUrl);
                        ?>
                        <a href="<?php echo $this->getBaseUrl() . 'special-offers/' . $uniqueOfferCategoryUrl; ?>"><button style="text-wrap: nowrap;" class="px-3 py-3 w-full font-bold uppercase text-sm lg:text-base text-nowrap hover:text-theme-golden" x-bind:class="{ 'text-theme-golden border-theme-golden border-b-2': current === '<?php echo $uniqueOfferCategory; ?>' }"><?php echo $uniqueOfferCategory; ?></button></a>
                    <?php endforeach; ?>
                </div>
                <?php foreach ($uniqueOfferCategories as $uniqueOfferCategory) : ?>
                    <?php
                    $offerCollectionCategoryWise = $block->getOfferCollectionFromCategory($uniqueOfferCategory);
                    ?>
                    <?php if ($offerCollectionCategoryWise->getData()) : ?>
                        <div x-show="current === '<?php echo $uniqueOfferCategory; ?>'" class="mt-6">
                            <div class="flex flex-wrap items-center">
                                <?php foreach ($offerCollectionCategoryWise as $offerCategoryWise) : ?>
                                    <?php
                                    if ($offerCategoryWise->getUrlBanner()) {
                                        $categoryUrl = '';
                                        $category = $offerCategoryWise->getCategory();
                                        $categoryUrl = strtolower($category);
                                        $categoryUrl = str_replace(' ', '-', $categoryUrl);
                                        $offerUrl = $baseUrl . 'special-offers/' . $categoryUrl . '/' . $offerCategoryWise->getUrlBanner();
                                    } else {
                                        $offerUrl = "#";
                                    }
                                    ?>
                                    <div class="w-full md:w-1/3 p-2.5">
                                        <div class="slide relative w-full rounded-xl overflow-hidden group transition duration-300 ease-out hover:shadow-lg">
                                            <a href="<?php echo $offerUrl; ?>" title="<?php echo $offerCategoryWise->getTitle(); ?>" aria-label="<?php echo $offerCategoryWise->getTitle(); ?>">
                                                <div class="image-wrap loader loader-sm w-full pb-[76%]">
                                                    <img src="<?php echo $this->getViewFileUrl('images/blank.png'); ?>" data-src="<?php echo $mediaURL . 'mageplaza/bannerslider/banner/image/' . $offerCategoryWise->getImage(); ?>" alt="<?php echo $offerCategoryWise->getTitle(); ?>" height="1" width="1" class="lazyload">
                                                </div>
                                            </a>
                                        </div>
                                    </div>
                                <?php endforeach; ?>
                            </div>
                        </div>
                    <?php endif; ?>
                <?php endforeach; ?>
            </div>
        <?php endif; ?>
    </div>
</section>
