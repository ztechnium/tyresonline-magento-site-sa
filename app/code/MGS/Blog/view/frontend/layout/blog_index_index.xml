<?xml version="1.0" encoding="UTF-8"?>
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" layout="1column" xsi:noNamespaceSchemaLocation="../../../../../../../lib/internal/Magento/Framework/View/Layout/etc/page_configuration.xsd">
    <head>
        <css src="css/blog.css" media="all"/>
    </head>
    <body>
        <referenceBlock name="catalog.compare.sidebar" remove="true"/>
        <referenceBlock name="wishlist_sidebar" remove="true"/>
        <referenceContainer name="sidebar.additional">
            <block class="MGS\Blog\Block\Sidebar" name="blog.sidebar" template="MGS_Blog::sidebar.phtml" after="-"/>
        </referenceContainer>
        <referenceContainer name="content">
            <block class="MGS\Blog\Block\Posts" name="post_list" template="MGS_Blog::posts.phtml"/>
        </referenceContainer>
        <referenceContainer name="page.top">
            <block class="Magento\Cms\Block\Block" name="blog-topblock" before="breadcrumbs">
                <arguments>
                    <argument name="block_id" xsi:type="string">special_offers_slider_home</argument> 
                </arguments>            
            </block>
        </referenceContainer>
    </body>
</page>
