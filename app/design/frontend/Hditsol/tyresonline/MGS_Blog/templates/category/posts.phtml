<?php
$helper = $this->helper('MGS\Blog\Helper\Data');
$contentImageHelper = $this->helper(\Hdweb\Tyrefinder\Helper\ProductImage::class);
$lazyBlank = $contentImageHelper->getLazyloadBlankUrl();
$contentImageOnError = $block->escapeHtmlAttr($contentImageHelper->getContentJsFallbackUrl());
$collection = $block->getCollection();
$showThumbnail = $this->getConfig('general_settings/show_thumbnail');
if ($this->getConfig('general_settings/thumbnail_width') != '') {
    $width = $this->getConfig('general_settings/thumbnail_width');
} else {
    $width = 240;
}
if ($this->getConfig('general_settings/thumbnail_height') != '') {
    $height = $this->getConfig('general_settings/thumbnail_height');
} else {
    $height = 180;
}
$categoryId = (int)$this->getRequest()->getParam('category_id', false);
?>
<div class="container custom-width">
<?php if (!count($collection)): ?>
    <div class="message empty">
        <div><?php echo __('Have no posts.') ?></div>
    </div>
<?php else: ?>
    <div class="blog-list row g-3 g-lg-4 justify-content-center">
        <?php foreach ($collection as $post): ?>
        	<div class="col-12 col-sm-6 col-md-6 col-lg-4">
            <div class="blog-post post-item-info">
				<div class="image-wrap picture aspect-custom loader <?php if ($showThumbnail): ?>has-image<?php endif; ?>">
			    <picture>
					<img class="lazyload" src="<?= $block->escapeUrl($lazyBlank) ?>" data-src="<?= $block->escapeUrl($contentImageHelper->getBlogThumbnailUrl($post)) ?>" alt="<?= $block->escapeHtmlAttr($post->getTitle()) ?>" data-content-image="1" onerror="this.onerror=null;this.src='<?= $contentImageOnError ?>'" />
				</picture>
				</div>
                 <div class="post-info">
						<h2 class="post-title">
							 <a class="post-title-link" title="<?php echo $post->getTitle(); ?>" href="<?php echo $post->getPostUrlWithNoCategory(); ?>"><?php echo $post->getTitle(); ?></a>
						</h2>
						<div class="create-post-time"><?php echo __('%1', $block->formatDate($post->getPublishedAt(), \IntlDateFormatter::MEDIUM, false)); ?></div>
					</div>
				<?php if ($post->getShortContent()): ?>
					<div class="post-content">
						<div class="post-short-description">
							<?php
							$shortContent = html_entity_decode(strip_tags((string) $post->getShortContent()), ENT_QUOTES | ENT_HTML5, 'UTF-8');
							$shortContent = preg_replace('/\s+/u', ' ', trim($shortContent));
							echo $block->escapeHtml(substr($shortContent, 0, 110));
							if (strlen($shortContent) > 105) {
								echo ' ...';
							}
							?>
						</div>
						<div class="post-link text-center">
							<a class="link" title="<?php echo __('Continue Reading'); ?>" href="<?php echo $post->getPostUrlWithNoCategory(); ?>"><span><?php echo __('Continue Reading'); ?></span></a>
						</div>
					</div>
				<?php endif; ?>
            </div>
            </div>	
        <?php endforeach; ?>
    </div>
	<div class="bottom-pagination">
		<div class="toolbar"><?php echo $block->getPagerHtml(); ?></div>
	</div>
<?php endif; ?>
</div>