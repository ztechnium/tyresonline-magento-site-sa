<?php $addVehicleUrl = $this->getBaseUrl().'tyrefinder/ajax/addvehicle'; ?>
<script type="text/javascript">
require(['jquery', 'jquery/ui'], function($){
  var emptyVehicleFieldErrTxt = "<?php echo __('Please select vehicle and then proceed!.'); ?>";
  jQuery('button#social-login-add-vehicle-submit').on('click',function() {
    var addVehicleUrl = '<?php echo $addVehicleUrl; ?>';
    var vehicle_make = jQuery('#social-login-popup #login-vehicle-select').find(":selected").val();
    var vehicle_make_label = jQuery('#social-login-popup #add_vehicle_make_label_login').val();
    var vehicle_model = jQuery('#social-login-popup #login-model-select').find(":selected").val();
    var vehicle_model_label = jQuery('#social-login-popup #add_vehicle_model_label_login').val();
    var vehicle_engine = jQuery('#social-login-popup #login-engine-select').find(":selected").val();
    var vehicle_engine_label = jQuery('#social-login-popup #add_vehicle_engine_label_login').val();
    if(vehicle_make !='' && vehicle_model !='' && vehicle_engine !=''){
      jQuery.ajax({
        type: 'POST',
        url: addVehicleUrl,
        data: {add_vehicle_make: vehicle_make, add_vehicle_make_label: vehicle_make_label, add_vehicle_model: vehicle_model, add_vehicle_model_label: vehicle_model_label, add_vehicle_engine: vehicle_engine, add_vehicle_engine_label: vehicle_engine_label},
        showLoader: true,
        success: function (resultData) {
          location.reload();
        }
      });
    }else{
      alert(emptyVehicleFieldErrTxt);
    }
    
  });   
});
</script>

