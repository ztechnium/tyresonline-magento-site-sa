<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" layout="1column" xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <head>
        <title>StoreLocator</title>
		<css src="css/storelocator.css" media="all"/>
    </head>
    <body>
        <!-- <attribute name="class" value="storelocator"/> -->
        <referenceContainer name="content">
            <!-- <block class="Ecomteck\StoreLocator\Block\StoreLocator" name="storelocator.stores"/> -->
            <block class="Magento\Framework\View\Element\Template" name="fitting_location" template="Ecomteck_StoreLocator::storelocator/all_stores.phtml"/>
        </referenceContainer>
        <referenceBlock name="page.main.title" remove="true" />
        <referenceBlock name="breadcrumbs" remove="true" />
    </body>
</page>
