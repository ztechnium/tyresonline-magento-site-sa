		function initAllInstallerMap() {
			if (!allInstallerlocations.length || !document.getElementById('map_canvas_all_installer')) {
				return;
			}

			var map = new google.maps.Map(document.getElementById('map_canvas_all_installer'), {
			  zoom: 8,
			  center: new google.maps.LatLng(23.88, 45.07),
			  mapTypeId: google.maps.MapTypeId.ROADMAP
			});

			var infowindow = new google.maps.InfoWindow();
			var marker, i;

			for (i = 0; i < allInstallerlocations.length; i++) {
			  marker = new google.maps.Marker({
				position: new google.maps.LatLng(allInstallerlocations[i][2], allInstallerlocations[i][3]),
				map: map
			  });

			  google.maps.event.addListener(marker, 'click', (function(marker, i) {
				return function() {
				  infowindow.setContent('<p>'+allInstallerlocations[i][0]+'</p>' +
							'<p><b>Address: </b>'+allInstallerlocations[i][1]+'</p>' +
							'<button onclick="sortInstallers('+allInstallerlocations[i][2]+','+allInstallerlocations[i][3]+')">Confirm</button>');
				  infowindow.open(map, marker);
				}
			  })(marker, i));
			}
		}

