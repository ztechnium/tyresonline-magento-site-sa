    function resetAllInstallerMap(){
    	var allInstallerlocations = <?php echo json_encode($allInstallerForMap); ?>;

		whenGoogleMapsReady(function () {
			if (!allInstallerlocations.length || !document.getElementById('map_canvas_all_installer')) {
				return;
			}

			var map = new google.maps.Map(document.getElementById('map_canvas_all_installer'), {
			  zoom: 8,
			  center: new google.maps.LatLng(23.88, 45.07),
			  mapTypeId: google.maps.MapTypeId.ROADMAP
			});

			var infowindow = new google.maps.InfoWindow();
			var marker, i;

			for (i = 0; i < allInstallerlocations.length; i++) {
			  marker = new google.maps.Marker({
				position: new google.maps.LatLng(allInstallerlocations[i][2], allInstallerlocations[i][3]),
				map: map
			  });

			  google.maps.event.addListener(marker, 'click', (function(marker, i) {
				return function() {
				  infowindow.setContent('<p>'+allInstallerlocations[i][0]+'</p>' +
							'<p><b>Address: </b>'+allInstallerlocations[i][1]+'</p>' +
							'<button onclick="sortInstallers('+allInstallerlocations[i][2]+','+allInstallerlocations[i][3]+')">Confirm</button>');
				  infowindow.open(map, marker);
				}
			  })(marker, i));
			}
		});
    }
    function sortInstallers(selectedMarkerLat,selectedMarkerLng){
		if(selectedMarkerLat != "" && selectedMarkerLng != "") {
			/*jQuery(".viewAllInMapClose").trigger("click");*/
			jQuery('#view-map').iziModal('close');
			setTimeout(function () {
			  resetAllInstallerMap();
			}, 1000)
			var p1 = new google.maps.LatLng(selectedMarkerLat, selectedMarkerLng);
			jQuery('.installer').each(function(i, obj) {
				var p2 = new google.maps.LatLng(jQuery(this).attr('data-lat'), jQuery(this).attr('data-lng'));

				var finalinstallerrdistance=(google.maps.geometry.spherical.computeDistanceBetween(p1, p2) / 1000).toFixed(2);

				finalinstallerrdistance=parseFloat(finalinstallerrdistance);
				jQuery(this).find('.miles').html(finalinstallerrdistance+' kms');
			    jQuery(this).find('.distance').show();
				var selectdistance=jQuery('#serach_distance').val();
				jQuery(this).removeAttr('data-position');
				jQuery(this).attr('data-position',finalinstallerrdistance);
				if(finalinstallerrdistance > selectdistance){
					
						jQuery(this).hide();
				}else{
						jQuery(this).show();
				}
			});
			
			jQuery('.installer').sort(function (a, b) {
				var contentA =parseInt( jQuery(a).attr('data-position'));
				var contentB =parseInt( jQuery(b).attr('data-position'));
				return (contentA < contentB) ? -1 : (contentA > contentB) ? 1 : 0;
			}).appendTo(".allInstaller");
		} else {
			jQuery('.installer').each(function(i, obj) {
			  jQuery(this).show();
			  jQuery(this).find('.distance').hide();
			  jQuery(this).find('.miles').html();
			});
		}
	}   
</script>
