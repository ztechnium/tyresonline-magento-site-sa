	require(["jquery", "mage/storage", "mage/calendar"], function($, storage){
		function resolveInstallerStoreId($checkbox) {
			var storesId = $checkbox.attr('data-storesid') || $checkbox.data('storesid');
			if (!storesId) {
				var idMatch = ($checkbox.attr('id') || '').match(/checkboxInstaller(\d+)/);
				storesId = idMatch ? idMatch[1] : '';
			}
			return storesId;
		}

		$(document).off('change.installerCheckbox', '.checkboxInstaller').on('change.installerCheckbox', '.checkboxInstaller', function () {
			var $checkbox = $(this);
			var storesId = resolveInstallerStoreId($checkbox);
			if (!storesId) {
				return;
			}

			var isChecked = $checkbox.prop('checked');
			var $panel = $('#submitInstaller' + storesId);

			if (isChecked) {
				$('.checkboxInstaller').not($checkbox).prop('checked', false);
				$('.datetimesubmit').not($panel).hide();
				$panel.show();
			} else {
				$panel.hide();
			}
		});

		$( document ).ajaxComplete(function( event, xhr, settings ) {
		    /* $(".storePickupdatepicker").datepicker({
	          showMonthAfterYear: false,
	          dateFormat:'mm/dd/yy',
	          changeMonth: true,
	          changeYear: true,
	          yearRange: '2020:2022',
	          minDate:0,
	        }); */
			var excludeDays = ['2023-06-28', '2023-06-29'];
			$(".storePickupdatepicker").each(function (event) {				
				jQuery(this).closest('.control').find('.storePickupdatepicker').datepicker({
				  showMonthAfterYear: false,
				  dateFormat:'mm/dd/yy',
				  changeMonth: true,
				  /* yearRange: '2021:2023', */
				 // minDate:jQuery(this).closest('.control').find('.pickup_store_skip_days').val(), //skip days
				  minDate:setMinDate(jQuery(this)), //skip days
				  beforeShow:function(textbox, instance){
					  jQuery(this).closest('.control').find('.storePickupdatepicker').parents(".datetimesubmit").append($('#ui-datepicker-div'));
					},
					beforeShowDay: function (date) {
						if (date.getDay() === 0) {
							return [false, ''];
						}
						return [disableSpecificDate(date), ''];
					}
				});
			 });
			function setMinDate(thisObject) {
				var skipDays = thisObject.closest('.control').find('.pickup_store_skip_days').val() || 0;
				var dts = new Date();
				var currentTime = dts.getHours() + ":" + dts.getMinutes();
				if(currentTime >= '18'){ /* after 6PM */
					if(skipDays != '' && skipDays != 0){
						skipDays = parseInt(skipDays) + 1;
					}
				}
					
			  return skipDays;
			}
			function disableSpecificDate(date) {
				// To disable specific day
				var dateArr = [String(date.getFullYear()), String(date.getMonth() + 1), String(date.getDate())];
				if (dateArr[1].length == 1) dateArr[1] = "0" + dateArr[1];
				if (dateArr[2].length == 1) dateArr[2] = "0" + dateArr[2];
				return excludeDays.indexOf(dateArr.join("-")) == -1;
			}
			function getInstallerSchedule(storeId) {
				return allStoreOpeningdatetimep[storeId] || allStoreOpeningdatetimep[String(storeId)] || null;
			}

			function resolveInstallerTimes(schedule, dayIndex, dayName) {
				if (!schedule || typeof schedule !== 'object') {
					return null;
				}

				return schedule[dayIndex] || schedule[String(dayIndex)] || schedule[dayName] || null;
			}

			function appendNoTimeSlotOption(storeId) {
				jQuery('select[data-storetimeid=' + storeId + ']').append(jQuery('<option>', {
					value: '',
					text: noSlotOptionText,
					disabled: 'disabled',
					selected: 'selected'
				}));
			}

			function convertSlotTime(timeStr) {
				var parts = jQuery.trim(timeStr).split(' ');
				var modifier = (parts[1] || '').toUpperCase();
				var timeParts = (parts[0] || '').split(':');
				var hours = parseInt(timeParts[0], 10);
				var minutes = timeParts[1] || '00';

				if (modifier === 'PM' && hours !== 12) {
					hours += 12;
				}
				if (modifier === 'AM' && hours === 12) {
					hours = 0;
				}

				return String(hours).padStart(2, '0') + ':' + minutes;
			}

			function populateInstallerTimeSlots(storeId, selectedDate, dayIndex, dayName) {
				var $select = jQuery('select[data-storetimeid=' + storeId + ']');
				$select.empty();

				var installerTimes = resolveInstallerTimes(getInstallerSchedule(storeId), dayIndex, dayName);
				if (!installerTimes || !installerTimes.length) {
					appendNoTimeSlotOption(storeId);
					return;
				}

				var optionsAdded = 0;
				jQuery.each(installerTimes, function(key, timeSlots) {
					if (!timeSlots) {
						return;
					}

					var storeStartTime = String(timeSlots).split('-');
					var timeStr = jQuery.trim(storeStartTime[0]);
					var storeOpentimeStr = convertSlotTime(timeStr);
					var currentTime = new Date();
					var isToday = todaydate === selectedDate;

					if (isToday) {
						var slotStart = new Date(selectedDate + ' ' + storeOpentimeStr);
						if (isNaN(slotStart.getTime()) || currentTime >= slotStart) {
							return;
						}
					}

					$select.append(jQuery('<option>', {
						value: timeSlots,
						text: timeSlots
					}));
					optionsAdded++;
				});

				if (optionsAdded === 0) {
					appendNoTimeSlotOption(storeId);
				}
			}

	     	jQuery('.storePickupdatepicker').change(function(){
