    });

    $(document).ready(function() {
        $('.star-rating').each(function() {
            var $container = $(this);
            var rating = parseFloat($container.data('rating'));

            $container.find('.star').each(function(index) {
                var fillPercent = Math.max(0, Math.min(1, rating - index)) * 100;
                $(this).find('rect.star-fill').attr('width', fillPercent + '%');
            });
        });
    });

    $(document).ready(function() {
        $('.product-specs .specs-dropdown').on('click', function() {
            var $container = $(this).closest('.product-specs');
            var $wrapper = $container.find('.spec-list-wrapper');
            var $arrowIcon = $container.find('.spec-arrow-icon');
            var isOpen = $wrapper.data('open') === true;

            if (isOpen) {
                $wrapper.css('height', $wrapper[0].scrollHeight + 'px');

                requestAnimationFrame(function() {
                    $wrapper
                        .css('height', '0px')
                        .removeClass('open')
                        .data('open', false);
                    $arrowIcon.removeClass('open');
                });
            } else {
                $wrapper.css('height', 'auto');
                var fullHeight = $wrapper[0].scrollHeight;

                $wrapper.css('height', '0px');

                requestAnimationFrame(function() {
                    $wrapper
                        .css('height', fullHeight + 'px')
                        .addClass('open')
                        .data('open', true);
                    $arrowIcon.addClass('open');
                });
            }

            $wrapper.one('transitionend', function() {
                if ($wrapper.data('open') === true) {
                    $wrapper.css('height', 'auto');
                }
            });
        });
    });
</script>

