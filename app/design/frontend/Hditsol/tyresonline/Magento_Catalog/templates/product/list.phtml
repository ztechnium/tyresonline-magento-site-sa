<script>
document.addEventListener('DOMContentLoaded', function () {
	function getCookieValue(name) {
		var match = document.cookie.match(new RegExp('(?:^|; )' + name.replace(/[$()*+.?[\\\]^{|}]/g, '\\$&') + '=([^;]*)'));
		return match ? decodeURIComponent(match[1]) : '';
	}

	function getLiveFormKey() {
		return getCookieValue('form_key') || window.FORM_KEY || '';
	}

	function syncFormKeys(root) {
		var formKey = getLiveFormKey();
		if (!formKey) {
			return;
		}

		(root || document).querySelectorAll('form[data-role="tocart-form"] input[name="form_key"]').forEach(function (input) {
			input.value = formKey;
		});
	}

	syncFormKeys(document);

	document.addEventListener('submit', function (event) {
		if (event.target && event.target.matches('form[data-role="tocart-form"]')) {
			syncFormKeys(event.target);
		}
	}, true);

	document.addEventListener('click', function (event) {
		var form = event.target && event.target.closest('form[data-role="tocart-form"]');
		if (form) {
			syncFormKeys(form);
		}
	}, true);
});
</script>

