$normalizeParam = static function ($value): string {
	if (is_array($value)) {
		$value = reset($value);
	}

	$value = is_scalar($value) ? trim((string) $value) : '';

	return in_array(strtolower($value), ['', 'none', 'null', 'undefined'], true) ? '' : $value;
};
$getTyreParam = static function ($request, string $name) use ($normalizeParam): string {
	$aliases = [
		'width' => 'tyre_width',
		'height' => 'tyre_height',
		'rim' => 'tyre_rim',
		'width_rear' => 'tyre_width_rear',
		'height_rear' => 'tyre_height_rear',
		'rim_rear' => 'tyre_rim_rear',
	];
	$aliasValue = $normalizeParam($request->getParam($aliases[$name] ?? $name));

	return $aliasValue !== '' ? $aliasValue : $normalizeParam($request->getParam($name));
};
