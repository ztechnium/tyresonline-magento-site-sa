<script type="text/javascript">
	function setCookie(name, value, days) {
		var expires = "";
		if (days) {
			var date = new Date();
			date.setTime(date.getTime() + (days * 24 * 60 * 60 * 1000));
			expires = "; expires=" + date.toUTCString();
		}
		document.cookie = name + "=" + (value || "") + expires + "; path=/";
	}
	setCookie('nibbleid', '0', 1);
	setCookie('nibbleproductid', '0', 1);
	setCookie('nibbleqty', '0', 1);
</script>

<script type="text/javascript">
	require(["jquery", "owlcarousel"], function($) {
		$('.product-image-wrapper').each(function(index) {
			const $wrapper = $(this);
			const $slider = $wrapper.find('.product-image-slider');
			const $items = $slider.find('.item');
			const total = $items.length;
			if (total <= 1) return;

			const direction = <?= ($storeCode === 'ar') ? -1 : 1; ?>;

			$slider.css({
				display: 'flex',
				transition: 'transform 0.3s ease',
				width: '100%'
			});
			$items.css({
				flex: '0 0 100%',
				width: '100%'
			});

			$wrapper.css('position', 'relative');

			const $btnLeft = $('<button class="nav-btn left">‹</button>');
			const $btnRight = $('<button class="nav-btn right">›</button>');
			$wrapper.append($btnLeft, $btnRight);

			const $dots = $('<div class="dots"></div>');
			for (let i = 0; i < total; i++) {
				$dots.append('<div class="dot"></div>');
			}
			$wrapper.append($dots);

			let currentIndex = 0;

			function updateSlider() {
				$slider.css('transform', `translateX(${currentIndex * direction * -100}%)`);
				$dots.children().removeClass('active').eq(currentIndex).addClass('active');
			}

			$btnLeft.on('click', function() {
				if (currentIndex > 0) {
					currentIndex--;
					updateSlider();
				}
			});

			$btnRight.on('click', function() {
				if (currentIndex < total - 1) {
					currentIndex++;
					updateSlider();
				}
			});

			updateSlider();
		});

		$('.qty-btn.plus').on('click', function() {
			const $input = $(this).closest('.qty-selection').find('.qty-input');
			const stockQty = parseInt($input.data('stockqty'), 10);
			let val = parseInt($input.val(), 10) || 0;

			if (val < stockQty) {
				val++;
				$input.val(val).attr('value', val).trigger('change');
				updateQtyButtonState($input);
			}
		});

		$('.qty-btn.minus').on('click', function() {
			const $input = $(this).closest('.qty-selection').find('.qty-input');
			let val = parseInt($input.val(), 10) || 0;

			if (val > 1) {
				val--;
				$input.val(val).attr('value', val).trigger('change');
				updateQtyButtonState($input);
			}
		});

		function updateQtyButtonState($input) {
			const val = parseInt($input.val(), 10) || 0;
			const stockQty = parseInt($input.data('stockqty'), 10);
			const $wrapper = $input.closest('.qty-selection');
			const $minusBtn = $wrapper.find('.qty-btn.minus');
			const $plusBtn = $wrapper.find('.qty-btn.plus');

			$minusBtn.prop('disabled', val <= 1).css('opacity', val <= 1 ? 0.2 : 1);
			$plusBtn.prop('disabled', val >= stockQty).css('opacity', val >= stockQty ? 0.2 : 1);
		}

		$(document).ready(function() {
			$('.star-rating').each(function() {
				var $container = $(this);
				var rating = parseFloat($container.data('rating'));

				$container.find('.star').each(function(index) {
					var fillPercent = Math.max(0, Math.min(1, rating - index)) * 100;
					$(this).find('rect.star-fill').attr('width', fillPercent + '%');
				});
			});
		});

		$(document).ready(function() {
			$('.product-specs .specs-dropdown').on('click', function() {
				var $container = $(this).closest('.product-specs');
				var $wrapper = $container.find('.spec-list-wrapper');
				var $arrowIcon = $container.find('.spec-arrow-icon');
				var isOpen = $wrapper.data('open') === true;

				if (isOpen) {
					$wrapper.css('height', $wrapper[0].scrollHeight + 'px');

					requestAnimationFrame(function() {
						$wrapper
							.css('height', '0px')
							.removeClass('open')
							.data('open', false);
						$arrowIcon.removeClass('open');
					});
				} else {
					$wrapper.css('height', 'auto');
					var fullHeight = $wrapper[0].scrollHeight;

					$wrapper.css('height', '0px');

					requestAnimationFrame(function() {
						$wrapper
							.css('height', fullHeight + 'px')
							.addClass('open')
							.data('open', true);
						$arrowIcon.addClass('open');
					});
				}

				$wrapper.one('transitionend', function() {
					if ($wrapper.data('open') === true) {
						$wrapper.css('height', 'auto');
					}
				});
			});
		});

	});
</script>

