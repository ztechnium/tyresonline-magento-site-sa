	<script type="text/javascript">
		var productIdForNibble = '<?php echo $_product->getId(); ?>';
		var baseUrl = '<?php echo $getBaseUrl; ?>';

		// Obtain the button element by whatever means you prefer
		const nibbleButton = document.getElementsByTagName('nibble-button')[0];

		// Add the two event listeners (see below for implementation)
		nibbleButton.addEventListener('nibble-session-start', mySessionStartFunction);
		nibbleButton.addEventListener('nibble-session-end', mySessionEndFunction);

		function mySessionStartFunction(event) {

			const successCallback = event.detail[0]
			const errorCallback = event.detail[1]

			let response = fetch(baseUrl + "tyrefinder/ajax/pricenegotiation?id=" + productIdForNibble)
				.then(response => response.json())
				.then(responseJson => successCallback(responseJson))
				.catch(error => console.log('error', error));
			return false;
		}

		function setCookie(name, value, days) {
			var expires = "";
			if (days) {
				var date = new Date();
				date.setTime(date.getTime() + (days * 24 * 60 * 60 * 1000));
				expires = "; expires=" + date.toUTCString();
			}
			document.cookie = name + "=" + (value || "") + expires + "; path=/";
		}

		function mySessionEndFunction(event) {

			// event.detail will be an array with three elemnts
			// The first is the Nibble ID
			const nibbleID = event.detail[0]
			// The second is the session status, one of 'open', 'successful',
			// or 'failed'
			const sessionStatus = event.detail[1]
			// The third is an optional callback, used to clean up the
			// negotiation UI and/or assist in adding to the basket
			const finalizeCallback = event.detail[2]

			// Statuses that are not 'successful' can be safely ignored,
			// in which case just instruct the Nibble window to close.
			if (sessionStatus !== 'successful') {
				finalizeCallback({
					close: true
				})
			}
			if (sessionStatus === 'successful') {

				// The listener should then instruct your server to verify
				// the session status, and add to basket if needed.
				let response = fetch(baseUrl + "tyrefinder/ajax/pricenegotiationverified?id=" + nibbleID)
					.then(response => response.json())
					.then(response => {
						/*		console.log(response)
								console.log(response.couponCode)*/
						setCookie('nibbleid', nibbleID, 1);
						setCookie('nibbleproductid', productIdForNibble, 1);
						setCookie('nibbleqty', response.quantity, 1);
						finalizeCallback({
							link: baseUrl + 'tyrefinder/ajax/pricenegotiationaddtocart?id=' + productIdForNibble + '&coupon=' + response.couponCode + '&qty=' + response.quantity + '&addproid=' + response.additionalProducts[0].productId
						})
					})

				//.then(responseJson => finalizeCallback({link: 'https://qa1.tyresonline.ae/en/checkout/cart/add/uenc/aHR0cHM6Ly9xYTEudHlyZXNvbmxpbmUuYWUvZW4veW9rb2hhbWEtMjk1LTQwLXIyMS0xMTF5LWFkdmFuLXNwb3J0LXYxMDUtMjAyMS5odG1sP2E9MzY%2C/product/6820'}))
				// .then(responseJson => finalizeCallback({link: 'https://qa1.tyresonline.ae/en/tyrefinder/ajax/nibbleaddtocart?id='+productIdForNibble+'&coupon=' + responseJson.couponCode}))


				// You may now instruct the Nibble If your software requires that
				// the user clicks a link to finish adding to basket, instruct
				// the Nibble widget to show that link. The widget will not
				// close without user interaction

			}
		}
	</script>
<?php endif; ?>