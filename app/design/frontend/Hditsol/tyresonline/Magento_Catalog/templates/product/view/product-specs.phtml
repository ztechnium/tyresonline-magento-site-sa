      <div class="specs-table" id="specs-table">
        <h2><?= $block->escapeHtml(__('Technical specs:')) ?></h2>
        <table>
          <?php foreach ($specRows as $label => $value): ?>
            <tr>
              <td><?= $block->escapeHtml($label) ?></td>
              <td><?= $block->escapeHtml($value) ?></td>
            </tr>
          <?php endforeach; ?>
