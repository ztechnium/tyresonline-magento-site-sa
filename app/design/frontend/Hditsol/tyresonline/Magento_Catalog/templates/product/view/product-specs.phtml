<script>
  function toggleContent() {
    const specsTable = document.getElementById('specs-table');
    const detailsContent = document.getElementById('details-content');

    if (!specsTable || !detailsContent) return;

    specsTable.classList.toggle('fade-out');
    detailsContent.classList.toggle('show');
  };
  
  document.addEventListener('DOMContentLoaded', () => {
    const specsContent = document.querySelector('.specs-content');
    if (!specsContent) return;
    let startX = 0;

    specsContent.addEventListener('touchstart', e => startX = e.changedTouches[0].screenX);

    specsContent.addEventListener('touchend', e => {
      const diffX = e.changedTouches[0].screenX - startX;
      if (Math.abs(diffX) > 50) toggleContent();
    });
  });
</script>