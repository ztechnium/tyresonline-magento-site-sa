<?php
$_product = $block->getProduct();
$objectManager = \Magento\Framework\App\ObjectManager::getInstance();
$productImageHelper = $this->helper(\Hdweb\Tyrefinder\Helper\ProductImage::class);
$tyreImageOnError = $block->escapeHtmlAttr($productImageHelper->getJsFallbackUrl());
$lazyBlank = $productImageHelper->getLazyloadBlankUrl();
$mediaUrl = $objectManager->get('Magento\Store\Model\StoreManagerInterface')
  ->getStore()
  ->getBaseUrl(\Magento\Framework\UrlInterface::URL_TYPE_MEDIA);
$_imagehelper = $this->helper('Magento\Catalog\Helper\Image');
$_productNameStripped = $block->stripTags($_product->getName(), null, true);
$imageDisplayArea = 'category_page_grid';
$image_width = 1020;
$image_height = 1020;
$productImage = $productImageHelper->getFallbackImageUrl($_product, $imageDisplayArea, $image_width, $image_height);

$getAttributeValue = static function ($attributeCode) use ($_product) {
  $attribute = $_product->getResource()->getAttribute($attributeCode);
  if (!$attribute) {
    return '';
  }

  $value = trim((string) $attribute->getFrontend()->getValue($_product));
  return in_array(strtolower($value), ['', 'no', 'none', 'n/a'], true) ? '' : $value;
};

$categoryNames = [];
foreach ($_product->getCategoryCollection()->addAttributeToSelect('name') as $category) {
  $name = trim((string) $category->getName());
  if ($name !== '' && !in_array($name, ['Default Category', 'Root Catalog'], true)) {
    $categoryNames[] = $name;
  }
}

$specRows = array_filter([
  __('Category')->render() => implode(', ', array_unique($categoryNames)),
  __('Vehicle')->render() => $getAttributeValue('vehicle'),
  __('Load Index')->render() => $getAttributeValue('load_index'),
  __('Speed Rating')->render() => $getAttributeValue('speed_index'),
  __('Wet Traction')->render() => $getAttributeValue('wet_grip'),
  __('Fuel Efficiency')->render() => $getAttributeValue('fuel_efficiency'),
  __('External noise')->render() => $getAttributeValue('noise_levels'),
  __('Origin')->render() => $getAttributeValue('manufacturer'),
  __('Manufactory Year')->render() => $getAttributeValue('year'),
  __('Warranty')->render() => $getAttributeValue('warranty_period'),
]);

$description = trim(strip_tags((string) $_product->getDescription()));
$hasProductDetails = $description !== '' && strcasecmp($description, (string) $_product->getName()) !== 0;
?>
