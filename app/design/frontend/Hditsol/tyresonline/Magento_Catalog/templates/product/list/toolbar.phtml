?>
<?php if ($block->getCollection()->getSize()) :?>
    <?php 
    $widget = $this->helper(\Magento\Framework\Json\Helper\Data::class)->jsonDecode($block->getWidgetOptionsJson());
        $widgetOptions = $this->helper(\Magento\Framework\Json\Helper\Data::class)->jsonEncode($widget['productListToolbarForm']);
    ?>
    <?php
    $objectManager = \Magento\Framework\App\ObjectManager::getInstance();
    $category = $objectManager->get('Magento\Framework\Registry')->registry('current_category');
    ?>
    <?php if($category->getId() == 4 || $category->getId() == 5): ?>
      <div class="product-topnav-mobile d-md-none">
        <ul class="list-custom d-flex justify-content-between">
          <li>
          <?php $params = $this->getRequest()->getParams(); ?>
            <?php if(isset($params['width']) && $params['width'] != ''): ?>
            <span class="custom-button d-flex align-items-center red search-result"> 
              <?php if(isset($params['width']) && $params['width'] != ''): ?>
                <?php echo $params['width'].'/'.$params['height'].' R'.$params['rim']; ?>
              <?php endif; ?>
              <?php if(isset($params['width_rear']) && $params['width_rear'] != ''): ?>
                <?php echo ' - '.$params['width_rear'].'/'.$params['height_rear'].' R'.$params['rim_rear']; ?>
              <?php endif; ?>
            </span>
            <?php endif; ?>
         </li>
        <?php $params = $this->getRequest()->getParams(); ?>
        <?php if(isset($params['categoryid'])):?>
          <li>
          <?php if(isset($params['width']) && isset($params['height']) && isset($params['rim'])):?>
            <span onclick="submitTyreSelection()" class="custom-button d-flex align-items-center search-button"><span><?php echo __('Modify Search');?></span></span>
          <?php else:?>
            <span onclick="submitVehicleSelection()" class="custom-button d-flex align-items-center search-button"><span><?php echo __('Modify Search');?></span></span>           
          <?php endif;?>
         </li>
        <?php else: ?>
          <li>
            <span onclick="submitTyreSelection()" class="custom-button d-flex align-items-center search-button"><span><?php echo __('Search');?></span></span>
          </li>
        <?php endif;?>
       </ul>
      </div>
    <?php endif; ?>
    <div class="toolbar toolbar-products" data-mage-init='{"productListToolbarForm":<?= /* @noEscape */ $widgetOptions ?>}'>
        <div class="row align-items-center">
            <div class="col-12 col-md-6 col-lg-6 col-xxl-6">
              <div class="left">
                <?php $params = $this->getRequest()->getParams(); ?>
                <div class="search-selection-list">
                  <ul class="list-custom d-flex flex-wrap align-items-center">
                    <?php if(isset($params['width']) && $params['width'] != ''): ?>
                      <li class="text"><?php echo __('Your Selections');?> :</li>
                    <?php endif; ?>
                    <?php if(isset($params['width']) && $params['width'] != ''): ?>
                      <li><span><?php echo $params['width'].'/'.$params['height'].' R'.$params['rim']; ?></span></li>
                    <?php endif; ?>
                    <?php if(isset($params['width_rear']) && $params['width_rear'] != ''): ?>
                      <li><span><?php echo $params['width_rear'].'/'.$params['height_rear'].' R'.$params['rim_rear']; ?></span></li>
                    <?php endif; ?>
                  </ul>
                </div>
                <?php include ($block->getTemplateFile('Magento_Catalog::product/list/toolbar/limiter.phtml')) ?>
              </div>
            </div>


            <div class="col-12 col-md-6 col-lg-6 col-xxl-6">
              <div class="right d-flex align-items-center justify-content-center justify-content-md-end">
              <?php if ($block->isExpanded()) :?>
                <?php include ($block->getTemplateFile('Magento_Catalog::product/list/toolbar/viewmode.phtml')) ?>
              <?php endif; ?>

              <?php if ($block->isExpanded()) :?>
                <?php include ($block->getTemplateFile('Magento_Catalog::product/list/toolbar/sorter.phtml')) ?>
              <?php endif; ?>
                
