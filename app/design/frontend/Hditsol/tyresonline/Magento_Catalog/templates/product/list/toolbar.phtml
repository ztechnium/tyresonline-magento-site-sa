                    <svg xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" version="1.1" x="0px" y="0px" viewBox="0 0 96 96" enable-background="new 0 0 96 96" xml:space="preserve"><path d="M92.164,12.076c-0.309-0.752-1.044-1.244-1.852-1.244H5.684c-0.812,0-1.544,0.492-1.848,1.244  c-0.308,0.752-0.132,1.608,0.444,2.176L38,47.524v35.64c0,0.712,0.38,1.372,0.996,1.736c0.312,0.18,0.656,0.264,1.004,0.264  c0.34,0,0.684-0.084,0.992-0.256l16-9.12C57.616,75.432,58,74.768,58,74.048V47.524l33.721-33.268  C92.292,13.684,92.468,12.824,92.164,12.076z"></path></svg>
                  </span>
                  <span class="text"><?php echo __('Filter');?></span>
                  </a>
                </div>

                <?= $block->getPagerHtml() ?>
              </div>
            </div>

        <?php //include ($block->getTemplateFile('Magento_Catalog::product/list/toolbar/amount.phtml')) ?>

    
      </div>
