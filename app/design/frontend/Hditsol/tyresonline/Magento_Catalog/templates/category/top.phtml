<?php
$objectManager = \Magento\Framework\App\ObjectManager::getInstance();
$contentImageHelper = $this->helper(\Hdweb\Tyrefinder\Helper\ProductImage::class);
$lazyBlank = $contentImageHelper->getLazyloadBlankUrl();
$contentImageOnError = $block->escapeHtmlAttr($contentImageHelper->getContentJsFallbackUrl());
$mediaURL = $objectManager->get('Magento\Store\Model\StoreManagerInterface')
    ->getStore()
    ->getBaseUrl(\Magento\Framework\UrlInterface::URL_TYPE_MEDIA);
$baseURL = $this->getBaseUrl();

$date = new \DateTime();
$currentDate = $date->format('Y-m-d');
$bannerFactory = $objectManager->get(\Mageplaza\BannerSlider\Model\BannerFactory::class);
$bannerCollection = $bannerFactory->create()->getCollection();

$bannerCollection->addFieldToFilter('status', 1);
$bannerCollection->getSelect()
    ->where('from_date is null OR from_date <= ?', $currentDate)
    ->where('to_date is null OR to_date >= ?', $currentDate);
$bannerCollection->setOrder('sort_order', 'ASC');
/* $bannerCollection->setPageSize(6); */

$timeZone = $objectManager->get('Magento\Framework\Stdlib\DateTime\TimezoneInterface');
$storeCode = $objectManager->get('Magento\Store\Model\StoreManagerInterface')->getStore()->getCode();
?>
<div class="product-offer-slider d-none d-md-block">
    <div class="owl-carousel owl-theme owl-nav-style1 owl-dot-style1 slider">
        <?php foreach ($bannerCollection as $banner) : ?>
            <?php
            if ($storeCode == 'en') {
                $offerImage3 = $banner->getBannerImageThree();
            } else {
                $offerImage3 = $banner->getBannerImageThreeAr() ?: $banner->getBannerImageThree();
            }
            $offerSliderUrl = $contentImageHelper->getBannerImageUrl($offerImage3);
            ?>
            <div class="item <?php echo $banner->getBannerId(); ?>">
                <a class="image-wrap picture loader aspect-custom" href="<?php echo $this->getBaseUrl() . $banner->getUrlBanner(); ?>">
                    <picture>
                        <source class="owl-lazy" srcset="<?= $block->escapeUrl($lazyBlank) ?>" media="(max-width: 767px)" data-srcset="<?= $block->escapeUrl($lazyBlank) ?>" />
                        <source class="owl-lazy" srcset="<?= $block->escapeUrl($lazyBlank) ?>" media="(min-width: 768px)" data-srcset="<?= $block->escapeUrl($offerSliderUrl) ?>" />
                        <img class="owl-lazy" src="<?= $block->escapeUrl($lazyBlank) ?>" alt="<?= $block->escapeHtmlAttr($banner->getTitle()) ?>" width="1470" height="137" data-src="<?= $block->escapeUrl($offerSliderUrl) ?>" data-content-image="1" onerror="this.onerror=null;this.src='<?= $contentImageOnError ?>'" />
                    </picture>
                </a>
            </div>
        <?php endforeach; ?>
    </div>
</div>