<script>
  (function () {
    function getCookieValue(name) {
      var match = document.cookie.match(new RegExp('(?:^|; )' + name.replace(/[$()*+.?[\\\]^{|}]/g, '\\$&') + '=([^;]*)'));
      return match ? decodeURIComponent(match[1]) : '';
    }

    function getLiveFormKey() {
      return getCookieValue('form_key') || window.FORM_KEY || '';
    }

    function syncAllFormKeys(root) {
      var formKey = getLiveFormKey();
      if (!formKey) {
        return;
      }

      window.FORM_KEY = formKey;

      (root || document).querySelectorAll('input[name="form_key"]').forEach(function (input) {
        input.value = formKey;
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', function () {
        syncAllFormKeys(document);
      });
    } else {
      syncAllFormKeys(document);
    }

    document.addEventListener('submit', function (event) {
      if (event.target) {
        syncAllFormKeys(event.target);
      }
    }, true);

    document.addEventListener('click', function (event) {
      var form = event.target && event.target.closest('form');
      if (form) {
        syncAllFormKeys(form);
      }
    }, true);

    if (window.jQuery && typeof window.jQuery.ajaxPrefilter === 'function') {
      window.jQuery.ajaxPrefilter(function (options, originalOptions) {
        var method = (options.type || originalOptions.type || 'GET').toUpperCase();
        if (method !== 'POST') {
          return;
        }

        var formKey = getLiveFormKey();
        if (!formKey) {
          return;
        }

        var reqUrl = options.url || '';
        if (reqUrl.indexOf('http') === 0 && reqUrl.indexOf(window.location.origin) !== 0) {
          return;
        }

        var contentType = options.contentType || originalOptions.contentType || '';
        var isJsonPayload = /application\/json/i.test(contentType) || (typeof options.data === 'string' && /^\s*[\[{]/.test(options.data));
        if (isJsonPayload || reqUrl.indexOf('/rest/') !== -1) {
          return;
        }

        if (typeof options.data === 'string') {
          if (/([?&]|^)form_key=/.test(options.data)) {
            options.data = options.data.replace(/([?&]|^)form_key=[^&]*/g, '$1form_key=' + encodeURIComponent(formKey));
          } else {
            options.data += (options.data.length ? '&' : '') + 'form_key=' + encodeURIComponent(formKey);
          }
        } else if (options.data && typeof options.data === 'object') {
          options.data.form_key = formKey;
        } else {
          options.data = 'form_key=' + encodeURIComponent(formKey);
        }
      });
    }

    setInterval(function () {
      syncAllFormKeys(document);
    }, 2500);
  })();
</script>
