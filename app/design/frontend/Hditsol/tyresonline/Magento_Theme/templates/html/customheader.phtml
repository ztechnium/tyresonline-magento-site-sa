<script type="text/javascript">
  require(["jquery"], function($) {
    function loadTyreWidthOptionsIfNeeded() {
      if ($('#allWidthOptions li').length > 0 && $('#allRearWidthOptions li').length > 0) {
        return;
      }
      if (typeof getWidthOptionsUrl === 'undefined' || !getWidthOptionsUrl) {
        return;
      }
      $('.searchloader').show();
      $.ajax({
        url: getWidthOptionsUrl,
        type: 'POST',
        data: { format: 'json' },
        complete: function () {
          $('.searchloader').hide();
        },
        success: function (data) {
          if (data.status === 'success') {
            $('#allWidthOptions').html(data.fronthtml);
            $('#allRearWidthOptions').html(data.rearhtml);
          }
        }
      });
    }

    function openHomeTyreSizeSearch() {
      $('#vehicle-selection').fadeOut();
      $('#tyre-selection').fadeIn();
      $('#tyre-selection .front-width_sub-block').show();
      $('html').addClass('scroll-overflow');
      $('html, body').animate({ scrollTop: 0 }, 0);
      $('.search-overlay').addClass('open');
      loadTyreWidthOptionsIfNeeded();
    }

    $(document).on('click', '.cms-home .tyre-search .search-wrap input, .cms-home .tyre-search .search-wrap .search-icon', function() {
      openHomeTyreSizeSearch();
    });

    $(document).on('click', '.cms-home .tyre-search .search-vehicle span', function() {
      $('#tyre-selection').fadeOut();
      $('#vehicle-selection').fadeIn();
      $('#vehicle-selection .brand_sub-block').show();
      $('html').addClass('scroll-overflow');
      $('html, body').animate({ scrollTop: 0 }, 0);
      $('.search-overlay').addClass('open');
    });
  });
</script>
