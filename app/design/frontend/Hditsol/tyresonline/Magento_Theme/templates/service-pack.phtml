<script type="text/javascript">
  require([
    'jquery',
    'bootstrap',
    ], function ($, bootstrap) {

    // Service box opn
    $(".service-compare").click(function (event) {
      if ($(this).hasClass('disabled')) {
        iziToast.info({
          message: 'Please add some services from the pack!',
          timeout: 3000,
          position: 'topRight',
          titleColor: '#fff',
          messageColor: '#fff',
          iconColor: '#fff',
          theme: 'dark',
          backgroundColor: '#dc3545',
        });
      } else {
        $(".col-custom").toggleClass("open");
        $(".oil-change").toggleClass("hide");
        $(this).toggleClass("active");
        $(this).tooltip('hide');
      }
    });

    // Service compare active img change
    var mediaURL = '<?php echo $mediaURL ?>';
    $imgred200 = mediaURL + "images/icon/service-compare-red-100.gif";
    $imgred300 = mediaURL + "images/icon/service-compare-red-200.gif";
    $(".service-compare").click(function(event) {
      if ($(this).hasClass('active')){
          $(".service-compare img").attr("src", $imgred200);
      } else {
         $(".service-compare img").attr("src", $imgred300); 
       }
    });

    // Service Box Opn arrow and box class change
    $(".collapse-box.left .toggle").click(function (event) {
      $(".collapse-box.left .toggle").toggleClass("active");
      $(".oil-change").toggleClass("half-width");
      $(".left-oil-toggle").toggle();
      $(".right-oil-toggle").toggleClass("col-md-6");
      $(".right-oil-toggle").toggleClass("col-md-12");
    });
    $(".collapse-box.right .toggle").click(function (event) {
      $(".collapse-box.right .toggle").toggleClass("active");
      $(".compare-service").toggleClass("half-width");
      $(".right-services-toggle").toggle();
      $(".right-services-toggle").toggleClass("col-md-6");
      $(".left-services-toggle").toggleClass("col-md-12");
    });
    // Box close service selection show
    $(".service-compare").click(function (event) {
      if ($(".compare-service").hasClass('half-width')) {
        $(".compare-service").removeClass('half-width');
        $(".right-services-toggle").toggle();
        $(".right-services-toggle").toggleClass("col-md-6");
        $(".left-services-toggle").toggleClass("col-md-12");
        $(".collapse-box.right .toggle").toggleClass("active");
      } else {
      }
    });

    // Title change
    $(".service-compare").click(function (event) {
      if ($(".col-custom").hasClass('open')) {
        $(".pack-title").hide();
        $(".pack-title-compare").show();
      } else {
        $(".pack-title").show();
        $(".pack-title-compare").hide();
      }
    });

    // Service box action button tooltip hide
    $(".email, .download").click(function (event) {
      $(this).tooltip('hide');
    });

    // selection box opn on click
    $("a[data-modal]").click(function (e) {
      e.preventDefault();
      var modalBox = $(this).attr('data-modal');
      $("#" + modalBox).fadeIn($(this).data());
    });
    $(".box-close").click(function () {
      $(this).parent(".content-box, .selection-box").fadeOut();
    });

    // services checked Editicon hide show
    $('.form-check-custom-style2').click(function () {
      if ($(this).children('.checkbox').prop("checked") == true) {
        $(this).parent('li').addClass('checked');
      }
      else if ($(this).children('.checkbox').prop("checked") == false) {
        $(this).parent('li').removeClass('checked');
      }
    });

    // Add Vehicle
    $(".add-vehicle").click(function () {
      $("html, body").animate({ scrollTop: 0 }, 0);
      //return false;
    });

    // Service box slider
    $(function () {
      var owl = $('.service-box-slider'),
        owlOptions = {
          loop: true,
          margin: 0,
          nav: false,
          items: 1,
          dots: true,
        };
      if ($(window).width() < 768) {
        var owlActive = owl.owlCarousel(owlOptions);
      } else {
        owl.addClass('off');
      }
      $(window).resize(function () {
        if ($(window).width() < 768) {
          if ($('.owl-carousel').hasClass('off')) {
            var owlActive = owl.owlCarousel(owlOptions);
            owl.removeClass('off');
          }
        } else {
          if (!$('.owl-carousel').hasClass('off')) {
            owl.addClass('off').trigger('destroy.owl.carousel');
            owl.find('.owl-stage-outer').children(':eq(0)').unwrap();
          }
        }
      });
    });
});
</script>